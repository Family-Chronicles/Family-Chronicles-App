# --- Web app (build time) ---
# Base URL of the Family Chronicles API. Default: same origin (/api/v1),
# which works with the Vite dev proxy and with docker-compose (nginx proxy).
VITE_API_URL=/api/v1
# Target of the dev proxy (only used by `npm run dev`)
API_PROXY_TARGET=http://localhost:8080

# --- docker-compose (full stack) ---
# Required: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Required on the first start: password of the initial admin (at least 8 characters)
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@family-chronicles.local
MONGO_USER=admin
MONGO_PASSWORD=admin
WEB_PORT=8000
# Path to the server repository
SERVER_PATH=../Family-Chronicles-Server
